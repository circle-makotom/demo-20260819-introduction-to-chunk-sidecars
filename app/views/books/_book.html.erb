<div id="<%= dom_id book %>">
  <div>
    <strong>Title:</strong>
    <%= book.title %>
  </div>

  <div>
    <strong>Isbn:</strong>
    <%= book.isbn %>
  </div>

  <div>
    <strong>Year:</strong>
    <%= book.year %>
  </div>

  <div>
    <strong>Author:</strong>
    <%= book.author_id %>
  </div>

</div>
